# Pushify self-host configuration — install.sh generates this for you.
# Manual setup: copy to .env next to docker-compose.yml and fill in.

# Public URLs of this installation (IP or domain, no trailing slash).
# NOTE: PUSHIFY_API_URL is baked into the dashboard at BUILD time —
# after changing it run: docker compose build frontend && docker compose up -d
PUSHIFY_API_URL=http://YOUR_SERVER_IP:4000
PUSHIFY_FRONTEND_URL=http://YOUR_SERVER_IP:3000

# Published ports
PUSHIFY_API_PORT=4000
PUSHIFY_FRONTEND_PORT=3000

# Secrets — generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
ENCRYPTION_KEY=

# Behind your own reverse proxy (nginx/traefik/caddy)? Set to the number of hops (usually 1).
TRUSTED_PROXY_HOPS=0

# ── Optional integrations ────────────────────────────────────────────────────
# Uncomment WITH a real value to enable. Don't leave a key set to an empty value —
# the backend rejects empty strings for email/URL settings.
#
# Email notifications (Gmail app password)
#GMAIL_USER=
#GMAIL_APP_PASSWORD=
# GitHub OAuth app — repo import + "login with GitHub"
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=
#GITHUB_CALLBACK_URL=
# Hetzner Cloud token — managed server provisioning (BYOS works without it)
#HETZNER_API_TOKEN=
# AI assistant
#ANTHROPIC_API_KEY=
# Admin event notification emails (comma-separated)
#ADMIN_NOTIFY_EMAILS=

# Domain sales — sell domains to your users via a registrar reseller account.
# Get credentials at https://www.name.com/reseller (test env: https://api.dev.name.com)
#REGISTRAR_PROVIDER=namecom
#NAMECOM_USERNAME=
#NAMECOM_TOKEN=
#NAMECOM_API_URL=https://api.name.com
# Retail margin % over wholesale (default 20) and max purchase price in cents (default 30000)
#DOMAIN_MARGIN_PERCENT=20
#DOMAIN_MAX_PRICE_CENTS=30000
