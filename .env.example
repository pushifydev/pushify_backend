# ─── Server ───
NODE_ENV=development
PORT=4000
# Public API root (no trailing slash) — GitHub webhooks, OAuth callbacks context
# API_BASE_URL=https://api.pushify.dev

# ─── Database (PostgreSQL) ───
DATABASE_URL=postgresql://user:password@localhost:5432/pushify

# ─── Process role ───
# Set by PM2 in ecosystem.config.cjs (api / worker). For npm run dev use:
PROCESS_ROLE=all

# ─── PostgreSQL pool (per process — API and worker each open their own pool) ───
# Total DB connections ≈ (API_instances × PG_POOL_MAX) + (worker_instances × PG_POOL_MAX)
PG_POOL_MAX=20
PG_POOL_IDLE_TIMEOUT_MS=30000
PG_POOL_CONNECTION_TIMEOUT_MS=10000

# ─── Redis (required in production for multi-instance API + worker queues) ───
# Rate limits, WebSocket pub/sub, deploy leader lock, GitHub/Stripe webhook dedupe, BullMQ.
REDIS_URL=redis://localhost:6379

# ─── JWT Authentication ───
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── CORS ───
CORS_ORIGIN=http://localhost:3000

# ─── Frontend URL (used in emails, notifications) ───
FRONTEND_URL=http://localhost:3000

# ─── GitHub ───
# Incoming repo webhooks (/api/v1/webhooks/github/:projectId) require the project's
# webhook secret (auto-generated on project create, or use “Regenerate” in the UI).
# Signed requests only; GitHub “ping” works without a secret until you paste one in GitHub.

# ─── GitHub OAuth (optional — for GitHub repo integration) ───
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# ─── GitLab OAuth (optional — for GitLab repo integration) ───
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=
# GITLAB_CALLBACK_URL=http://localhost:3000/auth/gitlab/callback
# GITLAB_BASE_URL=https://gitlab.com

# ─── Google OAuth (optional — for Google login) ───
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ─── Email / SMTP (optional — for notifications) ───
# Infra wallet low-balance email threshold (cents, default 1000 = $10)
# INFRA_LOW_BALANCE_WARN_CENTS=1000

# GMAIL_USER=noreply@example.com
# GMAIL_APP_PASSWORD=your-app-password
# GMAIL_FROM_NAME=Pushify

# ─── Preview Deployments (optional) ───
# PREVIEW_BASE_URL=preview.example.com

# ─── AI Assistant (optional — requires Anthropic API key) ───
# ANTHROPIC_API_KEY=sk-ant-...

# ─── Encryption (required — used for encrypting SSH keys) ───
ENCRYPTION_KEY=generate-a-64-char-hex-string-here-use-openssl-rand-hex-32

# ─── Hetzner Cloud (optional — for server provisioning) ───
# HETZNER_API_TOKEN=your-hetzner-api-token

# ─── Managed infrastructure billing ───
# Margin on Hetzner list price (percent). Customer price = provider cost × (1 + margin/100).
# INFRA_MARGIN_PERCENT=20
# EUR→USD conversion for Hetzner prices
# INFRA_EUR_TO_USD_RATE=1.08

# ─── Stripe (platform subscription + infra credit top-ups) ───
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# Production: use live keys and live Price IDs (overrides defaults in src/lib/stripe.ts)
# STRIPE_PRICE_HOBBY_MONTHLY=price_...
# STRIPE_PRICE_HOBBY_YEARLY=price_...
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_PRO_YEARLY=price_...
# STRIPE_PRICE_BUSINESS_MONTHLY=price_...
# STRIPE_PRICE_BUSINESS_YEARLY=price_...
# Webhook URL: https://api.yourdomain.com/api/v1/webhooks/stripe

# ─── Rate Limiting ───
RATE_LIMIT_ENABLED=true
# Auth routes (login/register/OAuth) — requests per IP per minute
RATE_LIMIT_AUTH_MAX=20
# Global API middleware (/api/*) — requests per IP per minute
# Unauthenticated /api/* only; authenticated traffic uses plan limits (see plans.ts)
RATE_LIMIT_API_MAX=200
# Webhook ingress — per project (or IP when unknown)
RATE_LIMIT_WEBHOOK_MAX=60
# Deploy triggers — per project per hour
RATE_LIMIT_DEPLOY_TRIGGER_MAX=20
# Forgot/reset password — per IP per 15 minutes
RATE_LIMIT_PASSWORD_RESET_MAX=3
# Sensitive routes — per IP per hour
RATE_LIMIT_SENSITIVE_MAX=10
